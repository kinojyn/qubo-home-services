# Required in Vercel Production. Use the final public HTTPS origin only.
# Do not include a trailing path, query string, fragment, or credentials.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Public Web3Forms form identifier for browser-side notification delivery.
# The destination email remains private in the verified Web3Forms account.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Persistent PostgreSQL storage for requests, admin users, settings, reviews, and media.
# Use a pooled TLS connection string supplied by your managed PostgreSQL provider.
DATABASE_URL=postgresql://user:password@host.example:5432/database?sslmode=require

# Admin setup. Use a random 32+ character JWT secret and a strong initial password.
ADMIN_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CRON_SECRET=replace-with-another-random-secret-of-at-least-32-characters
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-12-plus-character-password

# Google Search Console verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# VERCEL_ENV and VERCEL_URL are supplied automatically by Vercel.
# For a self-hosted single-instance deployment, CONTENT_STORAGE_DIR may point to
# an absolute persistent volume instead of DATABASE_URL. Do not use this on Vercel.
# CONTENT_STORAGE_DIR=/var/lib/qubo
#
# Do not commit database, email, analytics, or provider credentials here.
